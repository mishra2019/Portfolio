# Copy to ".env" at this folder (repo root):  cp .env.example .env
# The API and seed script load root .env first, then src/server/.env

# MongoDB — use Atlas SRV or local. Include DB name in the path, e.g. .../portfolio?retryWrites=true&w=majority
# URL-encode special characters in the password, or paste from Atlas "Connect" dialog.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# API port (optional; Render/Railway usually set PORT for you)
PORT=3001
