# Copy to ".env" in this folder:  cp .env.example .env
# Or use repo root ".env" — index.js and seed.js load ../../../.env then ../.env

# Local MongoDB (omit MONGODB_URI to use default mongodb://127.0.0.1:27017/portfolio)
# MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# MongoDB Atlas (replace USER, PASS, host; keep /portfolio and query string)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

PORT=3001
