# Copy to ".env" in this folder for local Vite:  cp .env.example .env

# When the API runs elsewhere, set origin with no trailing slash (production: your Render/Railway URL)
# VITE_API_BASE_URL=http://127.0.0.1:3001

# "true" = load bundled seed JSON only (no Mongo/API). Leave unset or "false" to use the API.
# VITE_STATIC_PORTFOLIO=false
